# ─────────────────────────────────────────────────────────────────
#  Variables d'environnement — Mossine Digital
#  Copier ce fichier en `.env.local` (ignoré par git) et remplir.
# ─────────────────────────────────────────────────────────────────

# ─── URL publique du site (canonical, OG, sitemap) ───────────────
# ⚠️ OBLIGATOIRE en production — sans ça, les URLs canonical et OG
#    pointent vers le fallback https://mossine-digital.com.
NEXT_PUBLIC_SITE_URL=https://mossinedigital.com

# ─── Sanity CMS ──────────────────────────────────────────────────
# Créer un projet sur https://sanity.io/manage puis coller l'ID ici.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Version d'API figée (format YYYY-MM-DD) — éviter "v1" ou "latest".
NEXT_PUBLIC_SANITY_API_VERSION=2026-04-16

# Token lecture — généré sur sanity.io/manage → API → Tokens (Viewer).
# Utilisé côté serveur uniquement (pas de NEXT_PUBLIC_).
SANITY_API_READ_TOKEN=

# ─── Resend (formulaire de contact) ──────────────────────────────
# Clé obtenue sur https://resend.com/api-keys
RESEND_API_KEY=
# Expéditeur vérifié (domaine validé DKIM/SPF côté Resend)
RESEND_FROM_EMAIL=Mossine Digital <noreply@mossinedigital.com>
# Destinataire des leads
CONTACT_NOTIFICATION_EMAIL=contact@mossinedigital.com

# ─── hCaptcha (anti-spam formulaire) ─────────────────────────────
# Plan gratuit : https://www.hcaptcha.com/ → Dashboard → Sites → New Site.
# Le MVP fonctionne en "mode gracieux" sans ces clés (widget non rendu,
# vérification serveur skippée — seul le honeypot reste actif). Configurer
# les deux variables avant go-live pour activer la protection.
#
# ⚠️ La site-key est PUBLIQUE (injectée côté client), la secret-key est
# PRIVÉE (serveur uniquement — ne jamais préfixer NEXT_PUBLIC_).
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# ─── Google Tag Manager + Google Analytics 4 ─────────────────────
# GTM est le CONTENEUR unique — on y configure GA4, Meta Pixel, Google
# Ads, événements custom, etc. via l'UI web. L'application Next.js
# charge uniquement GTM ; les autres tags sont gérés dans GTM.
#
# - Créer un compte sur https://tagmanager.google.com (gratuit)
# - Créer un conteneur "Web" → ID au format GTM-XXXXXXX
# - Créer un compte sur https://analytics.google.com → propriété GA4
#   → ID de mesure au format G-XXXXXXXXXX
# - Dans GTM, ajouter une balise "Google Analytics: GA4 Configuration"
#   avec l'ID G-XXXXXXXXXX, déclencheur "All Pages". C'est tout.
#
# Sans ces variables, aucun script analytics ne charge (mode gracieux).
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
